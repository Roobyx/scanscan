# scanscan compose/Portainer environment variables.
# Copy to .env and adjust.

# Image tag to build/run.
SCANSCAN_TAG=dev

# Host port for the app (web client + API).
SCANSCAN_PORT=8080

# Host port for the docs/landing site.
SCANSCAN_SITE_PORT=3000

# Host path to expose read-only at /host inside the container.
# Use / for the whole host, or a narrower path such as /mnt/data.
HOST_MOUNT=/

# Docker endpoint for the core (read-only). Set to the socket proxy when used.
DOCKER_HOST=unix:///var/run/docker.sock
