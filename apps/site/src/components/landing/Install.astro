---
import { install, site } from "../../data/site.js";

const commandText = install.commands.join("\n");
const escapeHtml = (value: string) =>
  value.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
const codeHtml = install.commands
  .map(
    (command) =>
      `<span class="terminal__line"><span class="terminal__prompt" aria-hidden="true">$</span>${escapeHtml(command)}</span>`,
  )
  .join("");
---

<section class="install section section--paper" id="install">
  <div class="container install__grid">
    <div class="install__copy">
      <h2 class="install__title h2" data-split="lines">Three commands. Then open the map.</h2>
      <p class="install__lede lede">
        The compose file builds the Rust core, the API and the web client, mounts the host
        read-only, and starts a GET-only Docker proxy.
      </p>

      <dl class="install__req">
        {
          install.requirements.map((item) => (
            <div class="install__req-row">
              <dt class="mono">{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="install__note">
        Open <code>localhost:8080</code> and press Scan. Start with <code>/var</code> or
        <code>/home</code>; a full <code>/</code> scan takes as long as the disk does.
      </p>
    </div>

    <div class="install__action">
      <div class="terminal">
        <div class="terminal__bar">
          <span class="mono">Terminal</span>
          <button class="copy-btn" type="button" data-copy={commandText}>
            <svg class="copy-btn__copy" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <rect
                x="5.5"
                y="5.5"
                width="8"
                height="8"
                fill="none"
                stroke="currentColor"
                stroke-width="1.25"
              ></rect>
              <path
                fill="none"
                stroke="currentColor"
                stroke-width="1.25"
                d="M10.5 3.5v-1h-8v8h1"></path>
            </svg>
            <svg class="copy-btn__check" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <path
                fill="none"
                stroke="currentColor"
                stroke-linecap="square"
                stroke-width="1.5"
                d="m3.5 8.5 3 3 6-7"></path>
            </svg>
            <span data-copy-text>Copy</span>
          </button>
        </div>
        <pre class="terminal__code" tabindex="0" aria-label="Install commands"><code set:html={codeHtml}></code></pre>
      </div>

      <ul class="install__links">
        <li>
          <a class="link" href={site.zip}>Download .zip</a>
        </li>
        <li>
          <a class="link" href="/installation/#portainer">Portainer stack</a>
        </li>
        <li>
          <a class="link" href="/installation/#from-source">From source</a>
        </li>
        <li>
          <a class="link" href="/cli/">CLI reference</a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .install__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: start;
  }

  .install__copy {
    grid-column: 1 / span 6;
  }

  .install__action {
    grid-column: 8 / span 5;
  }

  .install__title {
    max-width: 14ch;
  }

  .install__lede {
    margin-top: 1.15rem;
  }

  .install__req {
    display: flex;
    flex-direction: column;
    margin-top: 2rem;
    border-top: 1px solid var(--line);
  }

  .install__req-row {
    display: grid;
    grid-template-columns: 6rem 1fr;
    gap: 1rem;
    padding-block: 0.7rem;
    border-bottom: 1px solid var(--line);
  }

  .install__req-row dt {
    color: var(--muted);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  .install__req-row dd {
    margin: 0;
    color: var(--ink);
    font-size: 0.875rem;
    line-height: 1.5;
  }

  .install__note {
    margin-top: 1.5rem;
    color: var(--muted);
    font-size: 0.875rem;
    line-height: 1.55;
  }

  .install__note code {
    padding: 0.1em 0.3em;
    border: 1px solid var(--line);
    border-radius: 2px;
    background: rgb(11 14 20 / 0.04);
    color: var(--ink);
    font-family: var(--f-mono);
    font-size: 0.8125em;
  }

  .terminal {
    --ink: #e6ebf2;
    --muted: #8a97ab;
    --line: rgb(230 235 242 / 0.12);
    --line-strong: rgb(230 235 242 / 0.24);
    overflow: clip;
    border: 1px solid rgb(230 235 242 / 0.16);
    border-radius: var(--radius);
    background: var(--ground);
    color: var(--ink);
  }

  .terminal__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--line);
    color: var(--muted);
    font-size: 0.625rem;
  }

  .terminal__code {
    overflow-x: auto;
    margin: 0;
    padding: 1.1rem 0.9rem 1.25rem;
    font-family: var(--f-mono);
    font-size: 0.75rem;
    line-height: 1.9;
    white-space: pre;
  }

  .terminal__code:focus-visible {
    outline-offset: -3px;
  }

  .terminal__line {
    display: block;
  }

  .terminal__prompt {
    margin-right: 0.5rem;
    color: var(--accent);
  }

  .install__links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1.25rem;
    margin-top: 1.1rem;
    font-family: var(--f-mono);
    font-size: 0.6875rem;
  }

  .install__links .link {
    display: inline-flex;
    align-items: center;
    min-height: 1.5rem;
    padding-block: 0.3rem;
  }

  @media (max-width: 1000px) {
    .install__copy,
    .install__action {
      grid-column: 1 / -1;
    }

    .install__action {
      margin-top: 2rem;
    }

    .install__title {
      max-width: 22ch;
    }
  }

  @media (max-width: 560px) {
    .install__req-row {
      grid-template-columns: 5rem 1fr;
      gap: 0.75rem;
    }

    .terminal__code {
      font-size: 0.6875rem;
    }
  }
</style>
