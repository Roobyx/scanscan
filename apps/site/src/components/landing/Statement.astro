<section class="statement" id="why">
  <div class="statement__inner container">
    <h2 class="statement__title display" data-split="lines">
      Area is bytes. <br />Nothing else.
    </h2>
    <div class="statement__body">
      <p>
        A folder twice the size gets twice the area. No pie charts that flatter small folders, no
        top-ten list that hides the long tail.
      </p>
      <p>
        The map is the index, drawn. Read a block at rest, or open it and keep walking. The numbers
        never leave the tree.
      </p>
    </div>
  </div>
</section>

<style>
  .statement {
    padding-block: clamp(4.5rem, 9vw, 9rem);
    border-top: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .statement__inner {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--gutter);
    align-items: end;
  }

  .statement__title {
    grid-column: 1 / span 8;
    font-size: clamp(2.8rem, 1.2rem + 5.2vw, 6.2rem);
    line-height: 0.92;
    letter-spacing: -0.055em;
    margin-left: -0.045em;
  }

  .statement__body {
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-bottom: 0.5rem;
    color: var(--muted);
    font-size: var(--t-body);
    line-height: 1.55;
  }

  @media (max-width: 900px) {
    .statement__title,
    .statement__body {
      grid-column: 1 / -1;
    }

    .statement__body {
      max-width: 56ch;
      margin-top: 1.5rem;
    }
  }
</style>
