---
import { heroFacts, site } from "../../data/site.js";
import TreemapDemo from "./TreemapDemo.astro";
---

<section class="hero">
  <div class="hero__grid container">
    <div class="hero__copy">
      <h1 class="hero__title">Where did the disk space go?</h1>
      <p class="hero__lede">
        Index a filesystem once. Then walk it in a browser. Area is allocated bytes, so the biggest
        folder is the biggest block.
      </p>
      <div class="hero__actions">
        <a class="btn btn--primary btn--lg" href="#install" data-fill>
          <span class="btn__fill" aria-hidden="true"></span>
          <span>Run it with Docker</span>
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
            <path
              fill="none"
              stroke="currentColor"
              stroke-linecap="square"
              stroke-width="1.5"
              d="M3 8h9M8.5 4.5 12 8l-3.5 3.5"></path>
          </svg>
        </a>
        <a class="btn btn--ghost btn--lg" href="#views" data-fill>
          <span class="btn__fill" aria-hidden="true"></span>
          <span>See the views</span>
        </a>
      </div>
      <p class="hero__trust">Read-only by design. {site.license}.</p>
    </div>

    <div class="hero__map">
      <TreemapDemo />
    </div>

    <ul class="hero__facts" aria-label="Properties">
      {
        heroFacts.map((fact) => (
          <li class="hero__fact">
            <span class="hero__fact-value">{fact.value}</span>
            <span class="hero__fact-label">{fact.label}</span>
            <span class="hero__fact-note">{fact.note}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: calc(var(--header-h) + clamp(2rem, 5vw, 4.5rem));
    padding-bottom: clamp(3rem, 6vw, 6rem);
  }

  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--line) 1px, transparent 1px);
    background-size: 72px 72px;
    opacity: 0.32;
    -webkit-mask-image: radial-gradient(72% 62% at 62% 42%, #000 0%, transparent 78%);
    mask-image: radial-gradient(72% 62% at 62% 42%, #000 0%, transparent 78%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-template-rows: auto auto;
    gap: var(--gutter);
    align-items: start;
  }

  .hero__copy {
    grid-column: 1 / span 5;
    grid-row: 1;
  }

  .hero__map {
    grid-column: 6 / span 7;
    grid-row: 1 / span 2;
    align-self: center;
  }

  .hero__facts {
    grid-column: 1 / span 5;
    grid-row: 2;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: clamp(1.5rem, 3vw, 2.5rem);
    padding-top: 1rem;
    border-top: 1px solid var(--line);
  }

  .hero__title {
    margin-left: -0.04em;
    font-size: var(--t-mega);
    letter-spacing: -0.05em;
    line-height: 0.92;
    text-wrap: balance;
  }

  .hero__lede {
    max-width: 40ch;
    margin-top: clamp(1.25rem, 2vw, 1.75rem);
    color: var(--muted);
    font-size: var(--t-m);
    line-height: 1.5;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: clamp(1.5rem, 2.4vw, 2rem);
  }

  .hero__trust {
    margin-top: 1.15rem;
    color: var(--muted);
    font-family: var(--f-mono);
    font-size: 0.6875rem;
    line-height: 1.5;
  }

  .hero__fact {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    min-width: 0;
  }

  .hero__fact-value {
    color: var(--ink);
    font-family: var(--f-mono);
    font-size: 0.9375rem;
    font-variant-numeric: tabular-nums;
    line-height: 1.2;
  }

  .hero__fact-label {
    color: var(--ink);
    font-size: 0.8125rem;
    line-height: 1.2;
  }

  .hero__fact-note {
    color: var(--muted);
    font-family: var(--f-mono);
    font-size: 0.625rem;
    line-height: 1.3;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__title {
      animation: hero-settle 0.9s var(--ease-out) both;
    }

    .hero__lede {
      animation: hero-in 0.9s var(--ease-out) 0.08s both;
    }

    .hero__actions {
      animation: hero-in 0.9s var(--ease-out) 0.16s both;
    }

    .hero__trust {
      animation: hero-in 0.9s var(--ease-out) 0.22s both;
    }

    .hero__map {
      animation: map-in 1.1s var(--ease-out) 0.1s both;
    }

    .hero__facts {
      animation: hero-in 0.9s var(--ease-out) 0.3s both;
    }
  }

  @keyframes hero-in {
    from {
      opacity: 0;
      translate: 0 14px;
    }

    to {
      opacity: 1;
      translate: 0 0;
    }
  }

  @keyframes hero-settle {
    from {
      translate: 0 14px;
    }

    to {
      translate: 0 0;
    }
  }

  @keyframes map-in {
    from {
      opacity: 0;
      clip-path: inset(0 0 7% 0);
    }

    to {
      opacity: 1;
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 1080px) {
    .hero__copy,
    .hero__map,
    .hero__facts {
      grid-column: 1 / -1;
      grid-row: auto;
    }

    .hero__map {
      margin-top: clamp(2rem, 4vw, 3rem);
    }

    .hero__lede {
      max-width: 52ch;
    }

    .hero__facts {
      margin-top: 0;
      padding-top: 1.25rem;
    }
  }

  @media (max-width: 560px) {
    .hero__actions {
      gap: 0.5rem;
    }

    .hero__facts {
      gap: 0.75rem;
    }

    .hero__fact-note {
      display: none;
    }

    .hero__map {
      margin-top: 1.5rem;
    }
  }
</style>
